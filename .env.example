# Telegram Bot
TELEGRAM_TOKEN=YOUR_BOT_TOKEN_HERE
ADMIN_USER_ID=YOUR_USER_ID_HERE

# Balancer Server
BALANCER_IP=1.1.1.1
BALANCER_PATH=/opt/dumbproxy-balancer

# Proxy Servers
PROXY1_IP=2.2.2.2
PROXY1_PATH=/opt/dumbproxy-proxy
PROXY1_NAME=proxy1

PROXY2_IP=3.3.3.3
PROXY2_PATH=/opt/dumbproxy-proxy
PROXY2_NAME=proxy2

PROXY3_IP=4.4.4.4
PROXY3_PATH=/opt/dumbproxy-proxy
PROXY3_NAME=proxy3

# SSH
SSH_USER=root
SSH_TIMEOUT=10
SSH_KEY_PATH=~/.ssh/id_rsa

# Monitoring
CHECK_INTERVAL=300
LOG_LEVEL=INFO

# Features
ENABLE_HEALTH_CHECKS=true
ENABLE_AUTO_RESTART=false
ENABLE_NOTIFICATIONS=true
